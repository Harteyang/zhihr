# 后端 API 地址
API_BASE_URL=https://api.zhihr.vip

# mlook.mobi 凭证（用于获取 EPUB 下载链接）
MLOOK_USERNAME=
MLOOK_PASSWORD=

# LLM API 配置（用于知识提取）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Cloudflare 配置（备选，直接操作 D1）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DB_NAME=zhihr_db

# 处理间隔（秒）
POLL_INTERVAL=60

# EPUB 下载目录
DOWNLOAD_DIR=./downloads